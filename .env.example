# Copy this file to .env.local. Never commit real credentials.
# A single compatible gateway may be reused by all three profiles.
NARRATIVE_LLM_API_KEY=
NARRATIVE_LLM_BASE_URL=https://api.example.com/v1
NARRATIVE_LLM_MODEL=
# Optional model limits used when seeding environment-backed models.
NARRATIVE_LLM_CONTEXT_WINDOW=
NARRATIVE_LLM_MAX_OUTPUT_TOKENS=
# Optional OpenAI-compatible semantic indexing. If unset, retrieval uses FTS/entity signals only.
NARRATIVE_EMBEDDING_MODEL=
# Optional JSON keyed by profile id, e.g. {"env-openai-responses":{"input":1.25,"output":10,"cachedInput":0.125}}
NARRATIVE_MODEL_PRICING_JSON=

# Optional per-protocol overrides.
NARRATIVE_CHAT_API_KEY=
NARRATIVE_CHAT_BASE_URL=
NARRATIVE_CHAT_MODEL=
NARRATIVE_CHAT_CONTEXT_WINDOW=
NARRATIVE_CHAT_MAX_OUTPUT_TOKENS=
NARRATIVE_RESPONSES_API_KEY=
NARRATIVE_RESPONSES_BASE_URL=
NARRATIVE_RESPONSES_MODEL=
NARRATIVE_RESPONSES_CONTEXT_WINDOW=
NARRATIVE_RESPONSES_MAX_OUTPUT_TOKENS=
NARRATIVE_ANTHROPIC_API_KEY=
NARRATIVE_ANTHROPIC_BASE_URL=
NARRATIVE_ANTHROPIC_MODEL=
NARRATIVE_ANTHROPIC_CONTEXT_WINDOW=
NARRATIVE_ANTHROPIC_MAX_OUTPUT_TOKENS=

NARRATIVE_DATA_DIR=./data
# Prefer a different disk or synchronized directory for full backups.
NARRATIVE_BACKUP_DIR=./data/backups
# Docker Compose host path for the independent /app/backups mount.
NARRATIVE_BACKUP_HOST_DIR=./data/backups
NARRATIVE_BACKUP_RETENTION=10
NARRATIVE_BACKUP_INTERVAL_MINUTES=360
NARRATIVE_BACKUP_ON_STARTUP=false
NARRATIVE_SERVER_HOST=127.0.0.1
NARRATIVE_SERVER_PORT=4317
# Remote listening requires production mode, both values below, and TLS at the edge.
NARRATIVE_ALLOW_REMOTE=false
# NARRATIVE_AUTH_TOKEN=
# Docker Compose generates a local-only default when this is omitted. Set a
# high-entropy value before exposing the Web port beyond the local machine.
